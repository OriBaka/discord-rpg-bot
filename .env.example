# ============================================================
#  Discord RPG Bot — biến môi trường
#  Copy file này thành .env rồi điền giá trị thật.
#  Trên Railway: thêm từng biến ở tab Variables của service.
# ============================================================

# ---------- BẮT BUỘC ----------

# Token bot Discord. Lấy ở: Developer Portal → app của bạn → tab Bot → Reset Token.
# Đây là mật khẩu của bot — KHÔNG commit file .env, KHÔNG chia sẻ token.
DISCORD_TOKEN=dan_token_bot_cua_ban_vao_day

# ---------- NÊN SET ----------

# Prefix cho lệnh text. Đổi sang ký tự khác nếu trùng với bot khác trong server.
# Mặc định: !
PREFIX=%

# Danh sách user ID được quyền dùng lệnh admin, cách nhau bằng dấu phẩy.
# Cách lấy ID: Discord → Settings → Advanced → bật Developer Mode →
#             chuột phải vào tên mình → Copy User ID.  Vd: 123456789012345678
#
# ⚠️ NẾU BỎ TRỐNG: chỉ chủ server (guild owner) và người có quyền
#    "Administrator" mới dùng được lệnh admin. Bạn sẽ KHÔNG tự cấp
#    item/vàng cho mình được nếu không phải 1 trong 2 trường hợp đó.
#    Lệnh admin gồm: admin, item, mob, shop add/remove, quest admin,
#    ach admin, pet admin, gz, lootbox, redeem (tạo code), setimage,
#    slashadmin, petrestore, craft admin...
ADMIN_IDS=

# Đường dẫn file SQLite. Để trống → dùng ./data/rpg.db
# ⚠️ Trên Railway/Render/Fly PHẢI trỏ vào volume đã mount, vd: /data/rpg.db
#    Nếu không, mỗi lần redeploy là MẤT SẠCH người chơi.
DB_PATH=

# ---------- TUỲ CHỌN ----------

# ID server để deploy slash command riêng cho server đó.
# - Để trống: deploy global → Discord cache tới ~1 giờ mới thấy lệnh mới.
# - Set ID server: cập nhật gần như tức thì, tốt khi đang phát triển.
# Lấy ID server: chuột phải tên server (đã bật Developer Mode) → Copy Server ID.
SLASH_GUILD_ID=
